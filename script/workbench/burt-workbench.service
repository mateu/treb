[Unit]
Description=Burt isolated coding and gist broker
Before=burt-sandbox.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I %h/.local/share/burt-workbench/launch.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
MemoryMax=192M
TasksMax=24
# Account tools: the broker alone reads this private 0600 token file.
Environment=BURT_GITHUB_TOKEN_FILE=%h/.config/burt-github/token
# Non-secret writer allowlist / write cap shared with the bot unit.
EnvironmentFile=-%h/.config/burt-github/workbench.env

[Install]
WantedBy=default.target

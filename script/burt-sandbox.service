[Unit]
Description=Burt IRC bot sandbox
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/dev/treb
ExecStart=/usr/bin/bash -lc 'exec "$HOME/dev/treb/script/run-burt.sh"'
Restart=always
RestartSec=10s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/dev/treb
# Non-secret GitHub writer allowlist; run-burt-isolated.sh forwards only
# BURT_GITHUB_WRITERS into the bot namespace. The token stays with the broker.
EnvironmentFile=-%h/.config/burt-github/workbench.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

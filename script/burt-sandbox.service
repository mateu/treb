[Unit]
Description=Burt IRC bot sandbox
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/bash -lc 'echo "burt-sandbox requires the isolated release drop-in (80-workbench.conf); refusing to start unsandboxed" >&2; exit 1'
Restart=always
RestartSec=10s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# Non-secret GitHub writer allowlist; run-burt-isolated.sh forwards only
# BURT_GITHUB_WRITERS into the bot namespace. The token stays with the broker.
EnvironmentFile=-%h/.config/burt-github/workbench.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

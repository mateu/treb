# Critic example environment
# Source this before running critic.pl, then override as needed.

export OWNER="mateu"
export BOT_IDENTITY_SLUG="critic"
export ENGINE="Ollama"
export MODEL="kimi-k2.6:cloud"
export OLLAMA_URL="http://127.0.0.1:11434"
export IRC_SERVER="irc.perl.org"
export IRC_CHANNELS="#ai,#mateu-test"
export IRC_NICKNAME="critic_bot"
export BOT_FILTER_NICKS=""
export BOT_REPLY_PCT="35"
export BOT_REPLY_MAX_TURNS="3"
export DB_FILE="/home/hunter/dev/treb/critic.sqlite"
export MAX_LINE_LENGTH="400"
export BUFFER_DELAY="1"
export LINE_DELAY="1.5"
export IDLE_PING="1800"

# Optional prompt extension appended after the mission file.
# export SYSTEM_PROMPT=""
export PUBLIC_THREAD_WINDOW_SECONDS="0"
export PUBLIC_CHAT_ALLOW_PCT="40"
export JOIN_GREET_PCT="100"

# Optional explicit web search command support
export BRAVE_API_KEY=""
export MCP_TOOL_LOGGING="1"
export CLEANUP_LOGGING="1"
export STORE_SYSTEM_ROWS="1"
export STORE_NON_SUBSTANTIVE_ROWS="1"
export STORE_EMPTY_RESPONSE_ROWS="1"

# Optional: only set if your selected engine actually requires an API key.
# export API_KEY=""
